# A very general .gitignore for some python stuff 

# Virtual environments
.venv/
venv/
env/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Test / coverage caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checker / linter caches
.mypy_cache/
.pyright/
.ruff_cache/

# Build artifacts
build/
dist/
*.egg-info/
.eggs/

# Packaging
*.egg
pip-wheel-metadata/

# OS / desktop junk
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*.tmp
*.bak

# Optional local secrets / env config
.env
.env.*
